# CartLink - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ── Flask ─────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key
FLASK_DEBUG=True
PORT=5000

# ── OAuth ─────────────────────────────────────────────────────
# The redirect URI must match EXACTLY what you registered in Google Cloud Console
OAUTH_REDIRECT_URI=http://localhost:5000/auth/callback

# ── Google Drive ──────────────────────────────────────────────
# Optional: If set, files will be uploaded to this specific folder in Drive
# Leave empty to upload to the root of My Drive
GOOGLE_DRIVE_FOLDER_ID=

# ── Upload Limits ─────────────────────────────────────────────
# Maximum file size in megabytes
MAX_FILE_SIZE_MB=100

# Comma-separated list of allowed file extensions (no dots, no spaces)
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,jpg,jpeg,png,gif,zip,rar,mp4,mp3
